# Copy to .env and adjust.
#
# How far back to scan your inbox on the first (full) sync, in days.
SEARCH_HISTORY_DAYS=180

# How old an unhandled company email must be before it shows up under
# "Needs action" on the dashboard (days).
FOLLOWUP_AFTER_DAYS=2

# Port for the local dashboard server.
PORT=8000

# Default host to bind the dashboard to.
HOST=127.0.0.1