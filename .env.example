# Copy to .env and adjust. Values are also read from the real environment.

# --- Runtime ---
# Public base URL of the site, used to build the Google OAuth redirect URI.
BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# Where SQLite, the encrypted secret store, and the Fernet key live.
# On Render point this at the mounted disk, e.g. /data
DATA_DIR=./data

# --- Google OAuth (identity only) ---
# Only openid/email/profile scopes are requested. Gmail is never accessed.
# These can also be entered in the app under Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stable key guarding session cookies and the encrypted secret store.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Parsing & reminders ---
# Days to wait before the first check-back when an email has no timeline.
DEFAULT_FOLLOW_UP_DAYS=7
# IANA timezone used for date-only check-backs and calendar events.
APP_TIMEZONE=UTC

# --- Optional LLM fallback (OpenAI, xAI Grok, or Anthropic Claude) ---
# Leave blank to use rules only. The key can also be saved per user in Settings.
# Provider defaults: openai | grok | claude. Base URL and model are optional;
# blank values fall back to that provider's default endpoint and model.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
