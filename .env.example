# Copy to .env and adjust. All values are also read from the real environment.
#
# --- Runtime ---
# Public base URL of the site. On Render this is https://YOUR-APP.onrender.com
# It is used to build the OAuth redirect URI (BASE_URL/oauth/callback).
BASE_URL=http://127.0.0.1:8000

# Host/port to bind. On Render set HOST=0.0.0.0 and let PORT come from Render.
HOST=127.0.0.1
PORT=8000

# Where SQLite data, tokens, and keys live. On Render point this at the
# mounted persistent disk, e.g. /data
DATA_DIR=./data

# --- Google OAuth (Web application client) ---
# Can be entered in-app under Settings instead; if set, they take precedence.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret key guarding session cookies and the encrypted secret store.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Sync behaviour ---
# How far back to scan the inbox on the first (full) sync, in days.
SEARCH_HISTORY_DAYS=180

# How old an unhandled company email must be before it shows up under
# "Needs action" on the dashboard (days).
FOLLOWUP_AFTER_DAYS=2